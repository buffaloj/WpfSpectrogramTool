<Window x:Class="SpectrogramTool.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpectrogramTool.Wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        AllowDrop="true" Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Row 0: Takes up remaining space -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Sizes to fit the rectangle -->
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="message" Text="Drag a WAV file here" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
        
        <Image x:Name="myImage" 
               Grid.Row="0" 
               Stretch="Fill"
               MouseMove="image_MouseMove" 
                MouseEnter="image_MouseEnter" 
                MouseLeave="image_MouseLeave"
               MouseLeftButtonDown="myImage_MouseLeftButtonDown"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               Visibility="Collapsed"/>

        <Canvas  x:Name="canvas" 
                   Margin="0,10,0,0"
                   SizeChanged="canvas_SizeChanged"
                   Width="{Binding ElementName=myImage, Path=ActualWidth}" 
                   Grid.Row="1" Background="Red" Opacity="0.5" Height="250" VerticalAlignment="Bottom" Visibility="Collapsed"/>
    </Grid>
</Window>
